# Flask — REQUIRED: generate a random 64-character string
# Example: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Database (defaults to SQLite if omitted)
# Example: postgresql://user:pass@host:5432/db
DATABASE_URL=

# Google Gemini AI (optional)
GEMINI_API_KEY=

# Firebase (published client-safe keys — not secrets)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Resend (email delivery)
RESEND_API_KEY=

# Supabase Storage
SUPABASE_URL=
SUPABASE_STORAGE_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Encryption — generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
API_KEY_ENCRYPTION_KEY=

# Set to "true" to expose /api/reset-db, /api/clean-data, /api/migrate
ENABLE_ADMIN_TOOLS=
